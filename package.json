{
  "description": "Shared design system (tokens, themes, universal components) for Spudly apps: Eciperay and Memorize.",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-web": "^0.21.4",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "default": "./dist/pages/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'npm run typecheck'"
    ]
  },
  "main": "./dist/index.js",
  "name": "@spudly/ui",
  "packageManager": "npm@10.8.2",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "clean": "rm -rf dist",
    "lint": "echo 'lint disabled until typescript-eslint supports TypeScript 7 (it provided the TS parser and rules; see eslint.config.ts)'",
    "lint:fix": "echo 'lint disabled until typescript-eslint supports TypeScript 7 (it provided the TS parser and rules; see eslint.config.ts)'",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.6.0",
  "dependencies": {
