{
  "description": "Shared design system (tokens, themes, universal components) for Spudly apps: Eciperay and Memorize.",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@spudly/eslint-config": "^0.2.0",
    "@storybook/react-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-native": "^0.88.0",
    "react-native-web": "^0.21.4",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "default": "./dist/icons/index.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "default": "./dist/pages/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,tsx}": [
      "bash -c 'npm run typecheck'"
    ]
  },
  "main": "./dist/index.js",
  "name": "@spudly/ui",
  "packageManager": "npm@10.9.4",
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build-storybook": "npm run build-storybook:react --",
    "build-storybook:react": "storybook build",
    "changeset": "changeset",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "prepublishOnly": "npm run build",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "storybook": "npm run storybook:react --",
    "storybook:react": "storybook dev -p 6006",
    "storybook:react-native": "npm --prefix apps/storybook run storybook:react-native",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "version": "1.16.1",
  "dependencies": {
    "@tamagui/animations-css": "^3.0.15",
    "@tamagui/constants": "3.1.3",
    "tamagui": "^3.0.15",
    "react-native-svg": "^15.15.1"
  }
}
