{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/**/*.stories.tsx",
        "src/**/*.test.{ts,tsx}",
        "test/**/*.test.{ts,tsx}",
        "eslintRules/*.test.ts",
        ".storybook/main.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "eslintRules/**/*.{ts,mjs}",
        ".storybook/**/*.{ts,tsx}"
      ],
      "ignore": [
        ".storybook/assetsRegistryStub.ts",
        ".storybook/svgSoundModuleStub.ts",
        "test/stubs/reactNativeSvg.ts",
        "src/icons/index.ts",
        "src/views/index.ts",
        "src/widgets/index.ts"
      ],
      "ignoreDependencies": [
        "@commitlint/cli",
        "@spudly/tooling",
        "@storybook/react",
        "@storybook/react-native",
        "github-actionlint",
        "husky",
        "jscpd",
        "lint-staged",
        "prettier",
        "react-native-web",
        "storybook",
        "tsx"
      ]
    },
    "apps/storybook": {
      "entry": [
        "index.ts",
        ".rnstorybook/main.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@babel/core",
        "@gorhom/bottom-sheet",
        "@react-native-community/datetimepicker",
        "@react-native-picker/picker",
        "@storybook/react",
        "@tamagui/animations-css",
        "@tamagui/constants",
        "expo-constants",
        "expo-modules-core",
        "expo-status-bar",
        "expo-updates",
        "react-native-reanimated",
        "react-native-svg"
      ]
    }
  }
}
