  "description": "On-device Storybook host app for @spudly/ui (design-system #43): mounts the repo's CSF stories on Android via @storybook/react-native and doubles as the screenshot-capture target for tools/visualRegression. Not published.",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@types/react": "~19.3.0",
    "storybook": "10.6.3",
    "typescript": "^7.0.2"
  },
  "main": "index.ts",
  "name": "@spudly/design-system-storybook",
  "private": true,
  "scripts": {
    "android": "expo run:android",
    "generate": "sb-rn-get-stories --config-path .rnstorybook",
    "storybook:react-native": "npm run generate && expo start",
    "prestart": "npm run generate",
    "start": "expo start",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "version": "0.0.0"
